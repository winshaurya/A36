{
  "name": "origin-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "ORIGIN - Meme Provenance Protocol & Social Platform on Avalanche C-Chain",
  "workspaces": [
    "apps/*",
    "packages/*",
    "contracts"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspace=apps/web",
    "lint": "npm run lint --workspace=apps/web",
    "contracts:compile": "npm run compile --workspace=contracts",
    "contracts:test": "npm run test --workspace=contracts",
    "contracts:node": "npm run node --workspace=contracts"
  },
  "keywords": [
    "avalanche",
    "meme-provenance",
    "social",
    "web3",
    "fuji",
    "motion"
  ],
  "license": "MIT"
}
