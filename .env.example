# ============================================================
# ORIGIN - Environment Configuration
# ============================================================
# WARNING: NEVER commit private keys or secrets to git!
# Browser-safe variables must be prefixed with NEXT_PUBLIC_

# Public Blockchain Configuration
NEXT_PUBLIC_CHAIN_ID=43113
NEXT_PUBLIC_NETWORK_NAME=Avalanche Fuji Testnet
NEXT_PUBLIC_AVALANCHE_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
NEXT_PUBLIC_EXPLORER_URL=https://testnet.snowtrace.io

# Deployed Contract Addresses (Updated automatically on deployment)
NEXT_PUBLIC_PROVENANCE_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000

# Application Mode: 'demo' (mock without wallet/RPC requirement) or 'live'
NEXT_PUBLIC_APP_MODE=demo

# Server-Side / Deployment Secrets ONLY (DO NOT prefix with NEXT_PUBLIC_)
# PRIVATE_KEY=0x...
# SNOWTRACE_API_KEY=...
